# Environment Variables Example
# Copy this file to .env.local for local development

# API Base URL
# Development: Leave empty to use local fallback
# Production: Set to https://api.growlimo.com
NEXT_PUBLIC_API_URL=

# EmailJS Configuration
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_USER_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Calendly booking modal (homepage CTAs)
# Unset = CTAs fall back to navigating to /contact/
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/growlimo-info/30min

# Sentry DSN for error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Analytics ID (optional)
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_GTM_ID=
