# =====================================================
# GrowLimo Production Apache Configuration
# Updated: 2026-03-16 — Full SEO audit corrections
# Host: Naxsol cPanel / Apache
#
# CHANGES FROM ORIGINAL:
# 1. Added trailing slash enforcement (was missing — caused 51 crawl 301s)
# 2. Fixed limo redirects — were pointing to /services/ (soft 404)
# 3. Fixed service redirects — were chaining to removed pages
# 4. Added 13 removed page redirects (soft 404 fix)
# 5. Fixed regex typo (/._) → (/.*)
# 6. Added brotli pre-compressed serving
# 7. Images cache bumped 1 month → 1 year (Vite hashes them)
# 8. Fixed .json block — was blocking ALL json, now only sensitive files
# =====================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# =====================================================
# FORCE HTTPS
# =====================================================

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# =====================================================
# REMOVE WWW
# =====================================================

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# =====================================================
# ENFORCE TRAILING SLASH
# FIX: Was missing entirely — this single rule is the
# root cause of all 51 trailing-slash 301s in crawl.
# Skips real files (assets/images/js/css) and root /
# =====================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.\w+$
RewriteRule ^(.+)$ /$1/ [L,R=301]

# =====================================================
# OLD LIMO URL REDIRECTS → LIVE HEALTHCARE PAGES
# FIX: Were pointing to /services/ which no longer
# exists — created soft 404 chain. Now direct to
# live healthcare page in one hop.
# =====================================================

RewriteRule ^limo-marketing-(new-york|los-angeles|chicago|houston|miami|las-vegas|atlanta)-[a-z]{2}/?$ /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^limo-marketing-(california|texas|nevada|illinois|pennsylvania)/?$ /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^car-rental-marketing-florida/?$  /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^party-bus-marketing-new-york/?$  /healthcare-digital-marketing-agency-texas/ [L,R=301]

# =====================================================
# REMOVED PAGES — SERVER-SIDE 301 REDIRECTS
# FIX: All 13 were soft 404s (HTTP 200 + homepage HTML).
# These rules fire BEFORE the SPA fallback so Google
# receives a true 301 without React loading first.
#
# services/* sub-pages
# FIX: /services/seo was chaining to /services/healthcare-seo/
# which is also removed. Now goes direct to live page.
# =====================================================

RewriteRule ^services/seo/?$                    /healthcare-seo-services-texas/ [L,R=301]
RewriteRule ^services/ppc/?$                    /healthcare-ppc-services-texas/ [L,R=301]
RewriteRule ^services/social-media/?$           /social-media-marketing-services-texas/ [L,R=301]
RewriteRule ^services/healthcare-seo/?$         /healthcare-seo-services-texas/ [L,R=301]
RewriteRule ^services/medical-ppc/?$            /healthcare-ppc-services-texas/ [L,R=301]
RewriteRule ^services/marketing-automation/?$   /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^services/medical-website-design/?$ /web-design-services-texas/ [L,R=301]
RewriteRule ^services/reputation-management/?$  /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^services/?$                        /healthcare-digital-marketing-agency-texas/ [L,R=301]

# Specialty pages
RewriteRule ^dental-marketing/?$                /dentist-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^urgent-care-marketing/?$           /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^home-health-care-marketing/?$      /healthcare-digital-marketing-agency-california/ [L,R=301]
RewriteRule ^medical-lab-marketing/?$           /healthcare-seo-services-texas/ [L,R=301]
RewriteRule ^pt-chiropractic-marketing/?$       /healthcare-ppc-services-california/ [L,R=301]
RewriteRule ^std-testing-marketing/?$           /healthcare-digital-marketing-agency-texas/ [L,R=301]
RewriteRule ^cardiology-marketing/?$            /healthcare-digital-marketing-agency-texas/ [L,R=301]

# =====================================================
# BLOCK SYSTEM PATHS
# FIX: Regex typo (/._) only matched 1 char after dot.
# Corrected to (/.*)  to block all sub-paths properly.
# =====================================================

RewriteRule ^webmail(/.*)?$ - [R=410,L]
RewriteRule ^cpanel(/.*)?$  - [R=404,L]

# =====================================================
# SPA ROUTING FALLBACK
# MUST stay last — after ALL redirect rules above.
# Removed pages now get 301 before ever reaching here.
# =====================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L,QSA]

</IfModule>

# =====================================================
# SERVE PRE-COMPRESSED BROTLI
# FIX: Was missing. Vite generates .br files but the
# original config never served them. Brotli is ~30%
# smaller than gzip — direct Core Web Vitals benefit.
# =====================================================

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2)$">
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}\.br -f
    RewriteRule ^ %{REQUEST_URI}.br [L]
    Header append Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# =====================================================
# GZIP COMPRESSION (fallback when brotli not supported)
# =====================================================

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# =====================================================
# CACHING (Core Web Vitals)
# FIX: Images bumped from 1 month → 1 year.
# Vite content-hashes ALL asset filenames so cached
# files are never stale — safe to cache 1 year.
# =====================================================

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — never cache (always fetch fresh)
  ExpiresByType text/html                  "access plus 0 seconds"

  # CSS + JS — 1 year (Vite content-hashes filenames)
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"

  # Images — 1 year (FIX: was 1 month — Vite hashes these too)
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/x-icon               "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType application/font-woff2     "access plus 1 year"
</IfModule>

# =====================================================
# SECURITY HEADERS
# =====================================================

<IfModule mod_headers.c>
  Header always set X-Frame-Options          "SAMEORIGIN"
  Header always set X-Content-Type-Options   "nosniff"
  Header always set X-XSS-Protection         "1; mode=block"
  Header always set Referrer-Policy          "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# =====================================================
# BLOCK SENSITIVE FILES
# FIX: Original blocked ALL .json files — too broad.
# This blocked manifest.json, caseStudies.json, and
# any public JSON assets the React app depends on.
# Now only blocks truly sensitive file patterns.
# =====================================================

<FilesMatch "(\.env|error\.log|config\.js)$">
  Order allow,deny
  Deny from all
</FilesMatch>
