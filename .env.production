# Production Environment Variables
# These values are used when building for production (npm run build:prod)

# API Base URL - Production API endpoint
VITE_API_URL=https://api.growlimo.com

# Sentry DSN for error tracking (optional)
# Get your DSN from https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
VITE_SENTRY_DSN=

# Analytics ID (Google Analytics, etc.) - optional
VITE_ANALYTICS_ID=G-H9R39XYKXT
